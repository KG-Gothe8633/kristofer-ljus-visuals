---
import '../styles/global.css';
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Skicka ett uppdrag | Kristofer</title>
    <meta
      name="description"
      content="Skicka in ett uppdrag inom webb, SEO, Google Ads, grafiskt material eller digital support till Kristofer."
    />
  </head>

  <body>
    <header class="site-header portal-header">
      <div class="brand" aria-label="Kristofer">
        <span class="brand-mark">K</span>
        <span>
          <strong>Kristofer</strong>
        </span>
      </div>
    </header>

    <main>
      <section class="portal-hero">
        <div class="portal-intro">
          <p class="eyebrow">Uppdragsportal</p>
          <h1>Skicka ditt uppdrag.</h1>
          <p class="portal-lead">Beskriv kort vad du behöver hjälp med och bifoga material om det behövs.</p>
        </div>
      </section>

      <section class="portal-section">
        <form
          class="assignment-form"
          name="uppdrag"
          method="POST"
          action="/tack/"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          enctype="multipart/form-data"
        >
          <input type="hidden" name="form-name" value="uppdrag" />

          <p class="honeypot" aria-hidden="true">
            <label>
              Lämna detta fält tomt
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <fieldset class="form-card">
            <legend class="sr-only">Kontaktuppgifter</legend>
            <div class="form-heading">
              <span>01</span>
              <div>
                <p class="eyebrow">Kontakt</p>
                <h2>Dina uppgifter</h2>
              </div>
            </div>

            <div class="form-grid two-columns">
              <label class="field">
                <span>Namn <strong>*</strong></span>
                <input type="text" name="name" autocomplete="name" required />
              </label>

              <label class="field">
                <span>Företag / organisation <small class="optional-label">Frivilligt</small></span>
                <input type="text" name="company" autocomplete="organization" />
              </label>

              <label class="field">
                <span>E-post <strong>*</strong></span>
                <input type="email" name="email" autocomplete="email" required />
              </label>

              <label class="field">
                <span>Telefonnummer <small class="optional-label">Frivilligt</small></span>
                <input type="tel" name="phone" autocomplete="tel" inputmode="tel" />
              </label>
            </div>
          </fieldset>

          <fieldset class="form-card">
            <legend class="sr-only">Uppdragsinformation</legend>
            <div class="form-heading">
              <span>02</span>
              <div>
                <p class="eyebrow">Uppdrag</p>
                <h2>Uppgiften innefattar</h2>
              </div>
            </div>

            <div class="form-grid">
              <label class="field">
                <span>Typ av uppdrag <strong>*</strong></span>
                <select name="assignment_type" id="assignment-type" required>
                  <option value="" selected disabled>Välj typ av uppdrag</option>
                  <option value="Hemsida / webbdesign">Hemsida / webbdesign</option>
                  <option value="Webbshop / e-handel">Webbshop / e-handel</option>
                  <option value="WordPress">WordPress</option>
                  <option value="SEO">SEO</option>
                  <option value="Google Ads">Google Ads</option>
                  <option value="Google Business Profile / Maps">Google Business Profile / Maps</option>
                  <option value="Produktarbete">Produktarbete</option>
                  <option value="Text / innehåll">Text / innehåll</option>
                  <option value="Grafiskt material">Grafiskt material</option>
                  <option value="Foto">Foto</option>
                  <option value="Bild / bildredigering">Bild / bildredigering</option>
                  <option value="Sociala medier">Sociala medier</option>
                  <option value="Domän / e-post / DNS">Domän / e-post / DNS</option>
                  <option value="Teknisk support">Teknisk support</option>
                  <option value="Annat">Annat</option>
                </select>
              </label>

              <label class="field conditional-field" id="other-type-wrap" hidden>
                <span>Vad gäller uppdraget? <strong>*</strong></span>
                <input type="text" name="assignment_type_other" id="other-type" />
              </label>

              <label class="field">
                <span>Kort rubrik för uppdraget <strong>*</strong></span>
                <input
                  type="text"
                  name="assignment_title"
                  maxlength="120"
                  placeholder="Exempel: Ändra öppettider på hemsidan"
                  required
                />
              </label>

              <label class="field">
                <span>Beskriv uppdraget <strong>*</strong></span>
                <textarea
                  name="description"
                  rows="8"
                  placeholder="Beskriv vad som behöver göras, vad du vill uppnå och information som kan vara viktig för uppdraget."
                  required
                ></textarea>
              </label>

              <label class="field">
                <span>Länk till berörd sida</span>
                <input
                  type="text"
                  name="url"
                  inputmode="url"
                  placeholder="www.dinsida.se"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                />
                <small>Länk till exempelvis hemsida, produkt, annons eller annat som berör uppdraget. Du behöver inte skriva https:// själv.</small>
              </label>
            </div>
          </fieldset>

          <fieldset class="form-card">
            <legend class="sr-only">Önskat färdigdatum</legend>
            <div class="form-heading">
              <span>03</span>
              <div>
                <p class="eyebrow">Tid</p>
                <h2>När behöver det vara klart?</h2>
              </div>
            </div>

            <div class="choice-group deadline-options">
              <label class="choice-card">
                <input type="radio" name="deadline_choice" value="Helst igår" />
                <span>
                  <strong>Helst igår</strong>
                </span>
              </label>

              <label class="choice-card">
                <input type="radio" name="deadline_choice" value="1–3 dagar" />
                <span>
                  <strong>1–3 dagar</strong>
                </span>
              </label>

              <label class="choice-card">
                <input type="radio" name="deadline_choice" value="Inom en vecka" />
                <span>
                  <strong>Inom en vecka</strong>
                </span>
              </label>

              <label class="choice-card">
                <input type="radio" name="deadline_choice" value="Ta det när det passar" checked />
                <span>
                  <strong>Ta det när det passar</strong>
                </span>
              </label>

              <label class="choice-card choice-card-wide">
                <input type="radio" name="deadline_choice" value="Specifikt datum" />
                <span>
                  <strong>Jag har ett specifikt datum</strong>
                </span>
              </label>
            </div>

            <label class="field deadline-field" id="deadline-wrap" hidden>
              <span>Önskat färdigdatum <strong>*</strong></span>
              <input type="date" name="desired_date" id="desired-date" />
              <small>Datumet är ett önskemål och bekräftas efter att uppdraget har gåtts igenom.</small>
            </label>
          </fieldset>

          <fieldset class="form-card">
            <legend class="sr-only">Bilagor</legend>
            <div class="form-heading">
              <span>04</span>
              <div>
                <p class="eyebrow">Bilagor</p>
                <h2>Bifoga material</h2>
              </div>
            </div>

            <p class="attachment-intro">Du kan lägga till upp till tre valfria bilder eller dokument.</p>

            <div class="form-grid three-columns">
              <label class="field file-field">
                <span>Fil 1 <small class="optional-label">Frivilligt</small></span>
                <input
                  type="file"
                  name="attachment_1"
                  id="attachment-1"
                  accept="image/*,.pdf,.doc,.docx,.txt,.rtf,.xls,.xlsx,.ppt,.pptx"
                />
                <span class="file-picker" aria-hidden="true">+ Lägg till fil</span>
                <small class="file-name">Ingen fil vald</small>
              </label>

              <label class="field file-field">
                <span>Fil 2 <small class="optional-label">Frivilligt</small></span>
                <input
                  type="file"
                  name="attachment_2"
                  id="attachment-2"
                  accept="image/*,.pdf,.doc,.docx,.txt,.rtf,.xls,.xlsx,.ppt,.pptx"
                />
                <span class="file-picker" aria-hidden="true">+ Lägg till fil</span>
                <small class="file-name">Ingen fil vald</small>
              </label>

              <label class="field file-field">
                <span>Fil 3 <small class="optional-label">Frivilligt</small></span>
                <input
                  type="file"
                  name="attachment_3"
                  id="attachment-3"
                  accept="image/*,.pdf,.doc,.docx,.txt,.rtf,.xls,.xlsx,.ppt,.pptx"
                />
                <span class="file-picker" aria-hidden="true">+ Lägg till fil</span>
                <small class="file-name">Ingen fil vald</small>
              </label>
            </div>

            <p class="upload-note" id="upload-note">
              Bilagorna får tillsammans vara högst 7 MB.
            </p>
          </fieldset>

          <div class="submit-card">
            <div>
              <p class="eyebrow">Klart att skicka?</p>
              <h2>Jag tar det härifrån.</h2>
              <p>
                Dina kontaktuppgifter och bilagor används för att hantera och återkoppla kring det inskickade uppdraget.
              </p>
            </div>

            <button class="button primary submit-button" type="submit">Skicka uppdrag</button>
          </div>
        </form>
      </section>
    </main>

    <footer class="footer portal-footer">
      <p>© 2026 Kristofer · Uppdragsportal</p>
    </footer>

    <script is:inline>
      const assignmentType = document.querySelector('#assignment-type');
      const otherWrap = document.querySelector('#other-type-wrap');
      const otherType = document.querySelector('#other-type');
      const deadlineChoices = document.querySelectorAll('input[name="deadline_choice"]');
      const deadlineWrap = document.querySelector('#deadline-wrap');
      const desiredDate = document.querySelector('#desired-date');
      const attachments = [...document.querySelectorAll('input[type="file"]')];
      const uploadNote = document.querySelector('#upload-note');
      const form = document.querySelector('.assignment-form');
      const urlField = document.querySelector('input[name="url"]');

      const normalizeUrl = (value) => {
        const trimmed = value.trim();
        if (!trimmed) return trimmed;
        if (/^https?:\/\//i.test(trimmed)) return trimmed;
        return `https://${trimmed}`;
      };

      if (urlField) {
        urlField.addEventListener('blur', () => {
          if (urlField.value.trim()) {
            urlField.value = normalizeUrl(urlField.value);
          }
        });
      }

      const updateOtherType = () => {
        const showOther = assignmentType?.value === 'Annat';
        if (otherWrap) otherWrap.hidden = !showOther;
        if (otherType) {
          otherType.required = showOther;
          if (!showOther) otherType.value = '';
        }
      };

      const updateDeadline = () => {
        const selected = document.querySelector('input[name="deadline_choice"]:checked');
        const showDate = selected?.value === 'Specifikt datum';
        if (deadlineWrap) deadlineWrap.hidden = !showDate;
        if (desiredDate) {
          desiredDate.required = showDate;
          if (!showDate) desiredDate.value = '';
        }
      };

      const validateUploads = () => {
        const files = attachments.map((input) => input.files?.[0]).filter(Boolean);
        const totalBytes = files.reduce((sum, file) => sum + file.size, 0);
        const maxBytes = 7 * 1024 * 1024;
        const isValid = totalBytes <= maxBytes;

        if (uploadNote) {
          uploadNote.classList.toggle('error', !isValid);
          uploadNote.textContent = isValid
            ? 'Bilagorna får tillsammans vara högst 7 MB.'
            : 'Bilagorna är för stora. Välj filer som tillsammans är högst 7 MB.';
        }

        return isValid;
      };

      assignmentType?.addEventListener('change', updateOtherType);
      deadlineChoices.forEach((choice) => choice.addEventListener('change', updateDeadline));
      attachments.forEach((attachment) => {
        attachment.addEventListener('change', () => {
          const fileName = attachment.closest('.file-field')?.querySelector('.file-name');
          if (fileName) fileName.textContent = attachment.files?.[0]?.name || 'Ingen fil vald';
          validateUploads();
        });
      });

      form?.addEventListener('submit', (event) => {
        if (urlField && urlField.value.trim()) {
          urlField.value = normalizeUrl(urlField.value);
        }

        if (!validateUploads()) {
          event.preventDefault();
          uploadNote?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });

      if (desiredDate) {
        const today = new Date();
        const localDate = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
          .toISOString()
          .split('T')[0];
        desiredDate.min = localDate;
      }

      updateOtherType();
      updateDeadline();
    </script>
  </body>
</html>

<style>
  .portal-header {
    position: relative;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }

  .portal-hero {
    width: min(var(--max), calc(100% - 40px));
    margin: 0 auto;
    padding: clamp(76px, 10vw, 140px) 0 clamp(52px, 7vw, 90px);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(32px, 7vw, 110px);
    align-items: end;
  }

  .portal-intro h1 {
    max-width: 820px;
    margin-bottom: 28px;
    font-size: clamp(3.2rem, 7.2vw, 6.9rem);
  }

  .portal-lead {
    max-width: 720px;
    margin-bottom: 0;
    color: rgba(31, 31, 27, 0.72);
    font-size: clamp(1.08rem, 1.5vw, 1.32rem);
    line-height: 1.7;
  }

  .portal-note {
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.52);
  }

  .portal-note-label {
    margin-bottom: 20px;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .portal-note ol {
    margin: 0;
    padding-left: 1.3rem;
  }

  .portal-note li {
    padding: 10px 0;
    border-top: 1px solid var(--line);
    line-height: 1.45;
  }

  .portal-section {
    padding: 0 20px clamp(80px, 10vw, 140px);
    background:
      radial-gradient(circle at 80% 8%, rgba(142, 154, 123, 0.16), transparent 26%),
      var(--cream);
  }

  .assignment-form {
    width: min(980px, 100%);
    margin: 0 auto;
  }

  .form-card,
  .submit-card {
    margin: 0 0 20px;
    padding: clamp(26px, 5vw, 48px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 80px rgba(31, 31, 27, 0.055);
  }

  fieldset {
    min-width: 0;
  }

  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .form-heading {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 18px;
    align-items: start;
    margin-bottom: 34px;
  }

  .form-heading > span {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--black);
    border-radius: 50%;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .form-heading .eyebrow {
    margin-bottom: 9px;
  }

  .form-heading h2,
  .submit-card h2 {
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .form-grid {
    display: grid;
    gap: 22px;
  }

  .two-columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .field {
    display: grid;
    gap: 9px;
    min-width: 0;
    color: var(--black);
    font-size: 0.92rem;
    font-weight: 750;
  }

  .field > span strong {
    color: var(--sage-dark);
  }

  .optional-label {
    margin-left: 6px;
    color: rgba(31, 31, 27, 0.48);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .three-columns {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .choice-card-wide {
    grid-column: 1 / -1;
  }

  .field small,
  .choice-card small,
  .upload-note,
  .submit-card p {
    color: rgba(31, 31, 27, 0.62);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.5;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 13px 15px;
    border: 1px solid rgba(31, 31, 27, 0.2);
    border-radius: 14px;
    outline: none;
    background: rgba(245, 241, 232, 0.6);
    color: var(--black);
    font: inherit;
    font-weight: 500;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  textarea {
    min-height: 190px;
    resize: vertical;
    line-height: 1.55;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--sage-dark);
    box-shadow: 0 0 0 4px rgba(142, 154, 123, 0.14);
    background: var(--white);
  }

  input[type='file'] {
    padding: 10px;
    background: var(--cream);
  }

  input[type='file']::file-selector-button {
    margin-right: 12px;
    padding: 10px 14px;
    border: 0;
    border-radius: 10px;
    background: var(--black);
    color: var(--white);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
  }

  .choice-group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .choice-card {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--cream);
    cursor: pointer;
  }

  .choice-card input {
    width: 18px;
    min-height: 18px;
    margin: 2px 0 0;
    accent-color: var(--sage-dark);
  }

  .choice-card span {
    display: grid;
    gap: 5px;
  }

  .deadline-field {
    margin-top: 22px;
  }

  .upload-note {
    margin: 20px 0 0;
    padding: 13px 15px;
    border-radius: 12px;
    background: rgba(142, 154, 123, 0.12);
  }

  .upload-note.error {
    background: rgba(160, 78, 60, 0.12);
    color: #7c3b2e;
  }

  .submit-card {
    display: flex;
    justify-content: space-between;
    gap: 34px;
    align-items: end;
    background: var(--sage);
  }

  .submit-card .eyebrow {
    color: rgba(31, 31, 27, 0.68);
  }

  .submit-card p {
    max-width: 580px;
    margin-bottom: 0;
    color: rgba(31, 31, 27, 0.72);
  }

  .submit-button {
    flex: 0 0 auto;
    min-height: 56px;
    padding-inline: 28px;
    cursor: pointer;
  }

  .honeypot {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 900px) {
    .portal-header {
      position: relative;
    }

    .portal-hero,
    .two-columns,
    .three-columns,
    .choice-group {
      grid-template-columns: 1fr;
    }

    .portal-hero {
      padding-top: 64px;
    }

    .portal-intro h1 {
      font-size: clamp(3rem, 13vw, 4.8rem);
    }

    .submit-card {
      align-items: stretch;
      flex-direction: column;
    }

    .submit-button {
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .portal-section {
      padding-inline: 12px;
    }

    .portal-hero {
      width: min(var(--max), calc(100% - 28px));
    }

    .form-card,
    .submit-card {
      padding: 24px 18px;
      border-radius: 22px;
    }

    .form-heading {
      grid-template-columns: 36px 1fr;
      gap: 13px;
    }

    .form-heading > span {
      width: 36px;
      height: 36px;
    }
  }

  /* Tät enkelsida: optimerad för snabb användning på mobilen. */
  .portal-header {
    padding-block: 17px;
  }

  .portal-header .brand-mark {
    width: 38px;
    height: 38px;
  }

  .portal-hero {
    width: min(1020px, calc(100% - 40px));
    grid-template-columns: 1fr;
    padding: clamp(38px, 6vw, 70px) 0 clamp(28px, 4vw, 44px);
  }

  .portal-intro h1 {
    margin-bottom: 16px;
    font-size: clamp(2.7rem, 6vw, 5.2rem);
    line-height: 0.94;
  }

  .portal-lead {
    max-width: 620px;
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    line-height: 1.55;
  }

  .portal-section {
    padding-bottom: clamp(60px, 8vw, 100px);
  }

  .assignment-form {
    width: min(1020px, 100%);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 80px rgba(31, 31, 27, 0.055);
  }

  .form-card,
  .submit-card {
    margin: 0;
    padding: clamp(24px, 4vw, 38px);
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .form-heading {
    margin-bottom: 22px;
  }

  .form-heading .eyebrow {
    margin-bottom: 6px;
  }

  .form-heading h2,
  .submit-card h2 {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
  }

  .form-grid {
    gap: 15px 18px;
  }

  .field {
    gap: 7px;
  }

  input,
  select,
  textarea {
    min-height: 48px;
    padding: 11px 13px;
    border-radius: 12px;
  }

  textarea {
    min-height: 132px;
  }

  .choice-group {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .choice-card {
    min-height: 74px;
    padding: 13px;
    border-radius: 13px;
  }

  .choice-card-wide {
    grid-column: auto;
  }

  .deadline-field {
    margin-top: 15px;
  }

  .attachment-intro {
    margin: -5px 0 18px 60px;
